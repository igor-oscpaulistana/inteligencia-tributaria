# ── Claude (Anthropic) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5
ANTHROPIC_MODEL=

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=          # token permanente do System User
WHATSAPP_PHONE_NUMBER_ID=       # ID do número (não é o telefone)
WHATSAPP_APP_SECRET=            # App Secret — valida a assinatura do webhook
WHATSAPP_VERIFY_TOKEN=          # texto livre, o mesmo cadastrado no painel da Meta
WHATSAPP_GRAPH_VERSION=v24.0
# Modelo (template) aprovado com UMA variável no corpo, usado quando a
# janela de 24h está fechada (lembretes, avisos a clientes).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR

# ── CEO ───────────────────────────────────────────────────────────────
CEO_NAME=
CEO_WHATSAPP=                   # ex.: 5511987654321 (só dígitos, com DDI)
COMPANY_NAME=

# ── Outlook (Microsoft Graph, app registration no Entra ID) ───────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALENDAR_USER=               # e-mail (UPN) da caixa do CEO

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # só no servidor; nunca expor no cliente

# ── Agendador ─────────────────────────────────────────────────────────
CRON_SECRET=                    # a Vercel envia como "Authorization: Bearer ..."

# ── Preferências (todas opcionais) ────────────────────────────────────
TIMEZONE=America/Sao_Paulo
WORK_START=09:00
WORK_END=18:00
WORK_DAYS=1,2,3,4,5             # 0=domingo … 6=sábado
REMINDER_LEAD_MINUTES=60,15
BRIEFING_TIME=07:30             # agenda do dia + notícias
NEWS_DIGEST_TIME=18:00          # resumo extra de notícias (vazio = desliga)
NEWS_FOCUS=                     # temas de interesse do CEO, em texto livre
CLIENT_MIN_NOTICE_HOURS=4       # antecedência mínima para clientes pedirem reunião
ALLOW_UNKNOWN_CONTACTS=true     # atender números não cadastrados (acesso restrito)
