# Sem nenhuma variável, o painel roda em modo de demonstração:
# dados fictícios, sem login, execuções guardadas em memória.

# --- Supabase: autenticação, permissões por cliente, execuções e trilha ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service role). Só no servidor; nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- OneDrive via Microsoft Graph (aplicativo do Entra ID, somente leitura) ---
# Só é usado quando o Supabase também está configurado.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Drive que contém a pasta "Inteligência Tributária" e o item dessa pasta.
ONEDRIVE_DRIVE_ID=
ONEDRIVE_PASTA_RAIZ_ITEM_ID=

# --- Claude (API da Anthropic): redação do relatório, a partir da etapa 3 ---
# Mesmo formato do HUB do Paralegal. Sem a chave, o redator é o simulador.
ANTHROPIC_API_KEY=
