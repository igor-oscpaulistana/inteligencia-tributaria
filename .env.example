# Credencial da Claude API (ou use `ant auth login`)
ANTHROPIC_API_KEY=

# Pasta onde ficam os processos (documentos de clientes - dados pessoais, LGPD)
LEGALIZACAO_DADOS=./dados

# simulacao (padrão): portais simulados, nada é enviado a órgãos públicos
# producao: usa os adaptadores reais (exige mapeamento do portal + certificado digital)
LEGALIZACAO_MODO=simulacao

# Modelo e esforço do agente
LEGALIZACAO_MODELO=claude-opus-5-5
LEGALIZACAO_ESFORCO=high
